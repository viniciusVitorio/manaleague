<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true">
    <testsuites><testsuite name="Unit"><directory>tests/Unit</directory></testsuite><testsuite name="Feature"><directory>tests/Feature</directory></testsuite></testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- URL fixa: os testes de cabecalho (HSTS so em HTTPS) nao podem depender do APP_URL
             do .env da maquina, que muda ao testar atras de um tunel HTTPS. -->
        <env name="APP_URL" value="http://localhost"/>
        <!-- Scanner de cartas desligado por padrao; cada teste liga o que precisa via config(). -->
        <env name="CARD_SCANNER_URL" value=""/>
        <env name="CARD_SCANNER_TOKEN" value=""/>
        <env name="TRUSTED_PROXIES" value=""/>
        <env name="APP_KEY" value="base64:Zwg8Vi58yyja0i2uMfYZRw0klTp/PKUmMTUpo/EppbY="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="RANKED_AUTO_YEARLY_SEASON" value="false"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
