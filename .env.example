APP_NAME=ManaLeague
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Duração do "Manter conectado" no login (dias; navegadores limitam a ~400)
AUTH_REMEMBER_DAYS=365

CACHE_STORE=database
QUEUE_CONNECTION=database

# E-mail (log = grava em storage/logs/laravel.log; ses = Amazon SES)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responda@manaleague.com.br
MAIL_FROM_NAME=ManaLeague
AWS_SES_REGION=us-east-1
AWS_SES_CONFIGURATION_SET=
# Somente para testar SES fora da AWS; em producao use a IAM Role da EC2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Foto de perfil: local (storage/app/private/avatars, servida por /avatars/...) ou s3 (bucket privado,
# URLs assinadas). Em producao o S3 usa a IAM Role da EC2; AWS_ENDPOINT/AWS_USE_PATH_STYLE_ENDPOINT so para MinIO.
AVATAR_DISK=local
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
