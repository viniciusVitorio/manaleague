APP_NAME=ManaLeague
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL. No docker compose o host e o servico "db" e a senha cria o usuario no 1o boot.
# Gere a senha com: openssl rand -hex 24 (os testes automatizados continuam em SQLite em memoria).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=manaleague
DB_USERNAME=manaleague
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Duração do "Manter conectado" no login (dias; navegadores limitam a ~400)
AUTH_REMEMBER_DAYS=365

CACHE_STORE=database
QUEUE_CONNECTION=database
# Tempo real (Laravel Reverb). No Docker ja vem ligado (servico reverb; chave e segredo saem do APP_KEY).
# Fora do Docker fica desligado (as telas usam polling). Para ligar: BROADCAST_CONNECTION=reverb,
# REVERB_PORT=8081, REVERB_CLIENT_URL=ws://127.0.0.1:8081 e, noutro terminal, php artisan reverb:start --port=8081
# BROADCAST_CONNECTION=null

# E-mail (log = grava em storage/logs/laravel.log; ses = Amazon SES)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responda@manaleague.com.br
MAIL_FROM_NAME=ManaLeague
AWS_SES_REGION=us-east-1
AWS_SES_CONFIGURATION_SET=
# Somente para testar SES fora da AWS; em producao use a IAM Role da EC2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Foto de perfil: local (storage/app/private/avatars, servida por /avatars/...) ou s3 (bucket privado,
# URLs assinadas). Em producao o S3 usa a IAM Role da EC2; AWS_ENDPOINT/AWS_USE_PATH_STYLE_ENDPOINT so para MinIO.
AVATAR_DISK=local
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
