flowchart LR
    INTERNET["Internet / usuários<br/>GitHub e serviços AWS"]

    subgraph VPC["VPC exclusiva do laboratório — us-east-1"]
        direction TB
        IGW["Internet Gateway"]

        subgraph PUBLICAS["Redes públicas — 2 sub-redes / 2 zonas"]
            ALB["Load Balancer (ALB)<br/>Entrada restrita por IP"]
            NAT["NAT Gateway + IP fixo<br/>Somente saída das privadas"]
        end

        subgraph PRIVADAS["Redes privadas — 2 sub-redes / 2 zonas"]
            EC2["Servidor EC2 — nó do EKS<br/>ModSecurity + ManaLeague<br/>Sem IP público"]
            DB[("RDS PostgreSQL<br/>Single-AZ / sem acesso público")]
        end
    end

    INTERNET <-->|HTTP de entrada / HTTPS de saída| IGW
    IGW --> ALB
    ALB -->|Aplicação / porta 8080| EC2
    EC2 -->|PostgreSQL / TLS / 5432| DB
    EC2 -. Saída HTTPS .-> NAT
    NAT -.-> IGW

