variable "deploy_runtime_image" {
  type    = string
  default = ""
  validation {
    condition     = var.deploy_runtime_image == "" || can(regex("^${var.expected_account_id}[.]dkr[.]ecr[.]${var.aws_region}[.]amazonaws[.]com/${local.name}-deploy-runtime@sha256:[a-f0-9]{64}$", var.deploy_runtime_image))
    error_message = "Runtime image must be a digest-pinned ECR image in the expected account and region."
  }
}
variable "deploy_app_secret_arn" {
  type    = string
  default = ""
  validation {
    condition     = var.deploy_app_secret_arn == "" || can(regex("^arn:aws:secretsmanager:${var.aws_region}:${var.expected_account_id}:secret:manaleague-eks-lab-app-[A-Za-z0-9]{6}$", var.deploy_app_secret_arn))
    error_message = "Supply the exact lab application secret ARN."
  }
}
locals {
  deploy_runtime_image           = var.deploy_runtime_image
  deploy_runtime_buildspec       = "version: 0.2\nphases:\n  build:\n    commands:\n      - python3 /opt/manaleague-deploy/deploy.py\n"
  deploy_build_kubernetes_groups = aws_eks_access_entry.deploy.kubernetes_groups
  deploy_app_secret_permission   = { Effect = "Allow", Action = "secretsmanager:GetSecretValue", Resource = var.deploy_app_secret_arn }
  deploy_runtime_environment = merge(var.enable_lab_mail ? { MAIL_FROM_ADDRESS = local.lab_mail_from } : {}, {
    AWS_ACCOUNT_ID          = var.expected_account_id
    AWS_REGION              = var.aws_region
    LAB_APP_SECRET_ARN      = var.deploy_app_secret_arn
    AVATAR_BUCKET           = aws_s3_bucket.avatars.id
    RELEASE_ARTIFACT_BUCKET = var.enable_release_artifacts ? aws_s3_bucket.release_artifacts[0].id : ""
    RELEASE_ARTIFACT_PREFIX = var.enable_release_artifacts ? local.release_artifact_prefix : ""
    VPC_CIDR                = aws_vpc.lab.cidr_block
    APP_ROLE_ARN            = aws_iam_role.irsa["app"].arn
    ALLOWED_CIDRS           = join(",", sort(distinct(concat(var.allowed_client_cidrs, ["${aws_eip.nat.public_ip}/32"]))))
    SUBNET_IDS              = join(",", aws_subnet.public[*].id)
    ALB_SECURITY_GROUP_ID   = aws_security_group.alb.id
    DB_HOST                 = aws_db_instance.lab.address
    VPC_ID                  = aws_vpc.lab.id
    RDS_MASTER_SECRET_ARN   = aws_db_instance.lab.master_user_secret[0].secret_arn
    APP_URL                 = var.enable_lab_https ? "https://eks.manaleague.com.br" : "http://eks-lab.invalid"
    ACM_CERTIFICATE_ARN     = var.enable_lab_https ? aws_acm_certificate.lab[0].arn : ""
  })
}

# Activation requires reviewed packaging and a digest-pinned deploy runtime.
# Terraform checks the inputs; it does not attest their provenance.
locals {
  deploy_egress_tcp_ports = [80, 443]
  deploy_project_name     = "manaleague-eks-lab-deploy"
  deploy_broker_name      = "manaleague-eks-lab-deploy-broker"
  deploy_runtime_ecr_permissions = {
    Effect   = "Allow"
    Action   = ["ecr:DescribeRepositories", "ecr:DescribeImages"]
    Resource = [for key in ["app", "web"] : "arn:aws:ecr:${var.aws_region}:${var.expected_account_id}:repository/${local.name}-${key}"]
  }
  deploy_project_arn          = "arn:aws:codebuild:${var.aws_region}:${var.expected_account_id}:project/${local.deploy_project_name}"
  github_broker_invoker_trust = jsondecode(aws_iam_role.github_deploy.assume_role_policy)
  github_broker_invoker_permissions = {
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow", Action = "lambda:InvokeFunction", Resource = "arn:aws:lambda:${var.aws_region}:${var.expected_account_id}:function:${local.deploy_broker_name}"
    }]
  }
  deploy_broker_permissions = {
    Version = "2012-10-17"
    Statement = [
      { Effect = "Allow", Action = "codebuild:StartBuild", Resource = local.deploy_project_arn },
      { Effect = "Allow", Action = "codebuild:BatchGetBuilds", Resource = local.deploy_project_arn },
      { Effect = "Allow", Action = "codebuild:StopBuild", Resource = local.deploy_project_arn }
    ]
  }
}

# This path must contain a ZIP of orchestrator/deploy_broker.py at the ZIP root.
# No archive is supplied or generated by Terraform; packaging is an operator step.
variable "deploy_broker_zip_path" {
  type    = string
  default = ""
}

resource "aws_cloudwatch_log_group" "deploy_broker" {
  count             = var.enable_deploy_broker ? 1 : 0
  name              = "/aws/lambda/${local.deploy_broker_name}"
  retention_in_days = 7
}
resource "aws_cloudwatch_log_group" "deploy_build" {
  count             = var.enable_deploy_broker ? 1 : 0
  name              = "/aws/codebuild/${local.deploy_project_name}"
  retention_in_days = 7
}
resource "aws_iam_role" "deploy_broker" {
  count = var.enable_deploy_broker ? 1 : 0
  name  = local.deploy_broker_name
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{
    Effect = "Allow", Principal = { Service = "lambda.amazonaws.com" }, Action = "sts:AssumeRole"
  }] })
}
resource "aws_iam_role_policy" "deploy_broker" {
  count = var.enable_deploy_broker ? 1 : 0
  role  = aws_iam_role.deploy_broker[0].id
  policy = jsonencode({ Version = "2012-10-17", Statement = concat(local.deploy_broker_permissions.Statement, [
    { Effect = "Allow", Action = ["logs:CreateLogStream", "logs:PutLogEvents"], Resource = "${aws_cloudwatch_log_group.deploy_broker[0].arn}:*" }
  ]) })
}
resource "aws_lambda_function" "deploy_broker" {
  count            = var.enable_deploy_broker ? 1 : 0
  function_name    = local.deploy_broker_name
  role             = aws_iam_role.deploy_broker[0].arn
  handler          = "deploy_broker.lambda_handler"
  runtime          = "python3.12"
  filename         = var.deploy_broker_zip_path
  source_code_hash = try(filebase64sha256(var.deploy_broker_zip_path), null)
  timeout          = 15
  lifecycle {
    precondition {
      condition     = var.deploy_broker_zip_path != "" && can(filebase64sha256(var.deploy_broker_zip_path))
      error_message = "Package the reviewed orchestrator/deploy_broker.py into a ZIP before enabling."
    }
  }
  depends_on = [aws_iam_role_policy.deploy_broker]
}
resource "aws_iam_role" "github_broker_invoker" {
  count              = var.enable_deploy_broker ? 1 : 0
  name               = "${local.deploy_broker_name}-invoker"
  assume_role_policy = jsonencode(local.github_broker_invoker_trust)
}
resource "aws_iam_role_policy" "github_broker" {
  count  = var.enable_deploy_broker ? 1 : 0
  name   = "${local.deploy_broker_name}-invoke"
  role   = aws_iam_role.github_broker_invoker[0].id
  policy = jsonencode(local.github_broker_invoker_permissions)
}
output "github_broker_invoker_role_arn" {
  value = try(aws_iam_role.github_broker_invoker[0].arn, null)
}
resource "aws_security_group" "deploy_build" {
  count       = var.enable_deploy_broker ? 1 : 0
  name        = local.deploy_project_name
  description = "Proposed isolated deploy build egress"
  vpc_id      = aws_vpc.lab.id
}
resource "aws_vpc_security_group_egress_rule" "deploy_https" {
  count             = var.enable_deploy_broker ? 1 : 0
  security_group_id = aws_security_group.deploy_build[0].id
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = local.deploy_egress_tcp_ports[1]
  to_port           = local.deploy_egress_tcp_ports[1]
  ip_protocol       = "tcp"
}
resource "aws_vpc_security_group_egress_rule" "deploy_http" {
  count             = var.enable_deploy_broker ? 1 : 0
  security_group_id = aws_security_group.deploy_build[0].id
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = local.deploy_egress_tcp_ports[0]
  to_port           = local.deploy_egress_tcp_ports[0]
  ip_protocol       = "tcp"
}
resource "aws_vpc_security_group_ingress_rule" "cluster_deploy_build" {
  count                        = var.enable_deploy_broker ? 1 : 0
  security_group_id            = aws_security_group.cluster.id
  referenced_security_group_id = aws_security_group.deploy_build[0].id
  from_port                    = 443
  to_port                      = 443
  ip_protocol                  = "tcp"
}
resource "aws_iam_role" "deploy_build" {
  count = var.enable_deploy_broker ? 1 : 0
  name  = local.deploy_project_name
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{
    Effect    = "Allow", Principal = { Service = "codebuild.amazonaws.com" }, Action = "sts:AssumeRole"
    Condition = { StringEquals = { "aws:SourceAccount" = var.expected_account_id }, ArnEquals = { "aws:SourceArn" = local.deploy_project_arn } }
  }] })
}
resource "aws_iam_role_policy" "deploy_build" {
  count = var.enable_deploy_broker ? 1 : 0
  role  = aws_iam_role.deploy_build[0].id
  policy = jsonencode({ Version = "2012-10-17", Statement = [
    { Effect = "Allow", Action = ["logs:CreateLogStream", "logs:PutLogEvents"], Resource = "${aws_cloudwatch_log_group.deploy_build[0].arn}:*" },
    { Effect = "Allow", Action = "eks:DescribeCluster", Resource = aws_eks_cluster.lab.arn },
    local.deploy_runtime_ecr_permissions,
    local.deploy_app_secret_permission,
    { Effect = "Allow", Action = "ecr:GetAuthorizationToken", Resource = "*" },
    { Effect = "Allow", Action = ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"], Resource = "arn:aws:ecr:${var.aws_region}:${var.expected_account_id}:repository/${try(split("@", join("/", slice(split("/", var.deploy_runtime_image), 1, length(split("/", var.deploy_runtime_image)))))[0], "")}" },
    { Effect = "Allow", Action = "rds:DescribeDBInstances", Resource = aws_db_instance.lab.arn },
    { Effect = "Allow", Action = "secretsmanager:GetSecretValue", Resource = aws_db_instance.lab.master_user_secret[0].secret_arn },
    { Effect = "Allow", Action = ["ec2:CreateNetworkInterface", "ec2:DeleteNetworkInterface", "ec2:DescribeDhcpOptions", "ec2:DescribeNetworkInterfaces", "ec2:DescribeSubnets", "ec2:DescribeSecurityGroups", "ec2:DescribeVpcs"], Resource = "*" },
    { Effect = "Allow", Action = "ec2:CreateNetworkInterfacePermission", Resource = "arn:aws:ec2:${var.aws_region}:${var.expected_account_id}:network-interface/*", Condition = { StringEquals = { "ec2:AuthorizedService" = "codebuild.amazonaws.com", "ec2:Subnet" = [for subnet in aws_subnet.database : subnet.arn] } } }
  ] })
}
resource "aws_iam_role_policy" "deploy_build_https" {
  count = var.enable_deploy_broker && var.enable_lab_https ? 1 : 0
  role  = aws_iam_role.deploy_build[0].id
  policy = jsonencode({ Version = "2012-10-17", Statement = [{
    Effect = "Allow", Action = ["acm:DescribeCertificate", "acm:ListTagsForCertificate"], Resource = aws_acm_certificate.lab[0].arn
  }] })
}
resource "aws_codebuild_project" "deploy" {
  count        = var.enable_deploy_broker ? 1 : 0
  name         = local.deploy_project_name
  service_role = aws_iam_role.deploy_build[0].arn
  # Leave the client time to observe the terminal status and attempt cancellation.
  build_timeout          = 30
  queued_timeout         = 10
  concurrent_build_limit = 1
  artifacts { type = "NO_ARTIFACTS" }
  environment {
    compute_type                = "BUILD_GENERAL1_SMALL"
    image                       = local.deploy_runtime_image
    image_pull_credentials_type = "SERVICE_ROLE"
    dynamic "environment_variable" {
      for_each = local.deploy_runtime_environment
      content {
        name  = environment_variable.key
        value = environment_variable.value
        type  = "PLAINTEXT"
      }
    }
    type            = "LINUX_CONTAINER"
    privileged_mode = false
  }
  # Never execute repository-controlled buildspecs with this role. Execute only
  # the embedded entrypoint in the digest-pinned deploy runtime.
  source {
    type      = "NO_SOURCE"
    buildspec = local.deploy_runtime_buildspec
  }
  vpc_config {
    vpc_id             = aws_vpc.lab.id
    subnets            = [for subnet in aws_subnet.database : subnet.id]
    security_group_ids = [aws_security_group.deploy_build[0].id]
  }
  logs_config {
    cloudwatch_logs {
      group_name = aws_cloudwatch_log_group.deploy_build[0].name
    }
  }
  lifecycle {
    precondition {
      condition     = var.deploy_runtime_image != "" && var.deploy_app_secret_arn != ""
      error_message = "A pinned runtime image and exact application secret ARN are required."
    }
  }
  depends_on = [aws_route.private_nat, aws_route_table_association.database, aws_iam_role_policy.deploy_build]
}

resource "aws_eks_access_entry" "deploy_build" {
  count             = var.enable_deploy_broker ? 1 : 0
  cluster_name      = aws_eks_cluster.lab.name
  principal_arn     = aws_iam_role.deploy_build[0].arn
  type              = "STANDARD"
  kubernetes_groups = local.deploy_build_kubernetes_groups
}
